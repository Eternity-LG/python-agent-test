{
  // 按 F5 打开调试面板，选择下面任一配置运行 agent.py
  "version": "0.2.0",
  "configurations": [
    {
      // 推荐先用这个：假模型，不需要 API Key，不花额度
      "name": "agent.py 自检模式",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/agent.py",
      "args": ["--self-test"],
      "console": "integratedTerminal",
      "justMyCode": true,
      "python": "D:/AppDevelopment/Python311/python.exe"
    },
    {
      // 连真实模型调试：key 与 base_url 统一从项目根 .env 读取（别再写进本文件）
      "name": "agent.py 真实模型",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/agent.py",
      "console": "integratedTerminal",
      "justMyCode": true,
      "python": "D:/AppDevelopment/Python311/python.exe"
    },
    {
      // 推荐先用这个：假模型，不需要 API Key，不花额度
      "name": "agent2.py 自检模式",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/agent2.py",
      "args": ["--self-test"],
      "console": "integratedTerminal",
      "justMyCode": true,
      "python": "D:/AppDevelopment/Python311/python.exe"
    },
    {
      // 推荐先用这个：假模型，不需要 API Key，不花额度
      "name": "agent2.py 重试模式",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/agent2.py",
      "args": ["--resume", "1116-200511-0a94", "--self-test"],
      "console": "integratedTerminal",
      "justMyCode": true,
      "python": "D:/AppDevelopment/Python311/python.exe"
    },
    {
      // 连真实模型调试：key 与 base_url 统一从项目根 .env 读取（别再写进本文件）
      "name": "agent2.py 真实模型",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/agent2.py",
      "console": "integratedTerminal",
      "justMyCode": true,
      "python": "D:/AppDevelopment/Python311/python.exe"
    },
    {
      // 连真实模型调试：key 与 base_url 统一从项目根 .env 读取（别再写进本文件）
