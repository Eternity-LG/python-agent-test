# 复制成 .env 后填写（.env 已在 .gitignore 里，不会入库）
# 小米 MiMo 按量付费：OPENAI_BASE_URL=https://api.xiaomimimo.com/v1  ，key 形如 sk-xxxxx
# 小米 MiMo Token Plan：OPENAI_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1 ，key 形如 tp-xxxxx
# 注意两种 key 不通用，Base URL 与 key 必须成对
OPENAI_BASE_URL=https://api.xiaomimimo.com/v1
OPENAI_API_KEY=
MODEL=
